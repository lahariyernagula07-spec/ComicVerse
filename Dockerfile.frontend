FROM node:22-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.12.4 --activate

COPY package.json pnpm-workspace.yaml .npmrc ./
COPY artifacts/comicverse/package.json artifacts/comicverse/package.json
COPY lib/api-client-react/package.json lib/api-client-react/package.json
COPY lib/api-spec/package.json lib/api-spec/package.json
COPY lib/api-zod/package.json lib/api-zod/package.json
COPY lib/db/package.json lib/db/package.json
COPY scripts/package.json scripts/package.json

RUN pnpm install --no-frozen-lockfile

COPY . .

ENV NODE_ENV=production
ENV PORT=5173
ENV BASE_PATH=/
ENV VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

RUN pnpm --filter @workspace/comicverse build

EXPOSE 5173

CMD ["pnpm", "--filter", "@workspace/comicverse", "serve"]

# ComicVerse environment variables
# Copy this file to .env and replace the placeholder values.

# Frontend
PORT=5173
BASE_PATH=/
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Backend
API_PORT=3000
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
DATABASE_URL=postgresql://postgres:password@localhost:5432/comicverse

# AI providers (add at least one if using AI features)
GEMINI_API_KEY=
OPENAI_API_KEY=

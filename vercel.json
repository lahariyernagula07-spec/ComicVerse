{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/api-server build && pnpm --filter @workspace/comicverse build",
  "outputDirectory": "artifacts/comicverse/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}